# Prod vars:

# The base auth URL can be constructed by running:
# The directory where markdown files and other content paths will originate.
CONTENT_DIR=

# The postgres URL in the format:
# postgresql://{user}:{password}@{host ip}:{port (default 5432)}/{db name}
DATABASE_URL=

# Sending API key and domain for Mailgun
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# The reply-to name and address for transactional emails
MAILGUN_SENDER_NAME=
MAILGUN_SENDER_EMAIL=

# Dev vars:

# Whether to set `Secure` on `gel-pkce-verifier` and `gel-auth-token` cookies.
# In practice, you only need to set this variable if COOKIE_SECURE=false
# (typically dev environments). In all other instances, such as prod environments,
# we use secure cookies by default.
COOKIE_SECURE=

# The port your Leptos app is served on
SERVER_PORT= 

# Test vars: 

# The base auth URL to use in tests
TEST_AUTH_URL=

# A place to receive test emails
TEST_EMAIL_RECIPIENT=

# Working JWTs to test SurgeonCas inserts.
# The JWT to Identity mapping is unique to each branch of the DB, and can't simply be copied.
SURGEON_TEST_JWT=
COHORT_TEST_JWT=
